{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Provider": "Entra"
  },
  "Auth:ZeroAuth": {
    "AllowedProviders": [ "ZeroAuth", "test" ]
  },
  "Auth:Entra": {
    "TenantId": "box",
    "ClientId": "box-web",
    "ClientSecret": "box-web-secret",
    "CallbackPath": "/api/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "ExternalCallbackPath": "/api/users/signin-oidc"
  },
  "AzureTableAccounts": {
    "table-users": {
      "ServiceUri": "https://rgboxtest.table.core.windows.net/"
    }
  },
  "AzureTableBootstrap": {
    "Entries": [
      {
        "AnchorKey": "table-users",
        "Tables": [ "userProfiles", "externalUsers" ]
      }
    ]
  }
}
