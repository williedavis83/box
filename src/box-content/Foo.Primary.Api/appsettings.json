{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bleeb": {
    "BaseUri": "http://localhost:5130"
  },
  "AzureTableAccounts": {
    "table-orders": {
      "ServiceUri": "https://rgboxtest.table.core.windows.net/"
    },
    "table-analytics": {
      "ServiceUri": "https://rgboxtest.table.core.windows.net/"
    },
    "table-geo-us-east": {
      "ServiceUri": "https://rgboxtest.table.core.windows.net/"
    },
    "table-geo-eu-west": {
      "ServiceUri": "https://rgboxtest.table.core.windows.net/"
    }
  },
  "AzureTableBootstrap": {
    "Entries": [
      {
        "AnchorKey": "table-orders",
        "Tables": [ "orders" ]
      },
      {
        "AnchorKey": "table-analytics",
        "Tables": [ "analytics" ]
      },
      {
        "AnchorKey": "table-geo-us-east",
        "Tables": [ "boxBasics" ]
      },
      {
        "AnchorKey": "table-geo-eu-west",
        "Tables": [ "boxBasics" ]
      }
    ]
  }
}
